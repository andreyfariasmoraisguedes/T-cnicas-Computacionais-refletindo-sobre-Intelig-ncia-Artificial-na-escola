:root {
    --cor-fundo: #000000;
    --cor-tela: #020802;
    --cor-verde: #39ff14;
    --cor-verde-fraco: #1dff8a;
    --cor-verde-escuro: #0b3d14;
    --cor-texto: #b8ffb0;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px;
    background-color: var(--cor-fundo);
    color: var(--cor-texto);
    font-family: "Share Tech Mono", "Courier New", Courier, monospace;
    overflow-x: hidden;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
        radial-gradient(ellipse at center, rgba(57, 255, 20, 0.08), transparent 55%),
        repeating-linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0) 0px,
            rgba(0, 0, 0, 0) 2px,
            rgba(0, 255, 70, 0.035) 3px
        );
    z-index: 0;
}

.caixa-principal {
    position: relative;
    z-index: 1;
    width: 92%;
    max-width: 720px;
    background-color: var(--cor-tela);
    text-align: center;
    padding: 28px 24px 32px;
    border: 3px solid var(--cor-verde);
    border-radius: 18px;
    box-shadow:
        0 0 12px var(--cor-verde),
        0 0 28px rgba(57, 255, 20, 0.45),
        0 0 60px rgba(57, 255, 20, 0.18),
        inset 0 0 30px rgba(57, 255, 20, 0.08);
}

.caixa-principal::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(57, 255, 20, 0.35);
    border-radius: 12px;
    pointer-events: none;
}

h1 {
    color: var(--cor-verde);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: clamp(1.4rem, 4vw, 2rem);
    text-shadow:
        0 0 8px var(--cor-verde),
        0 0 18px rgba(57, 255, 20, 0.7);
    margin-bottom: 8px;
}

.subtitulo {
    color: var(--cor-verde-fraco);
    font-size: 0.95rem;
    margin-bottom: 22px;
    opacity: 0.85;
}

.progresso {
    color: var(--cor-verde);
    font-size: 0.85rem;
    margin-bottom: 16px;
    letter-spacing: 1px;
}

.caixa-perguntas {
    color: var(--cor-texto);
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: 22px;
    text-align: left;
}

.caixa-alternativas {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

button {
    background-color: #001400;
    color: var(--cor-verde);
    border: 1px solid var(--cor-verde);
    border-radius: 10px;
    padding: 14px 16px;
    font-family: inherit;
    font-size: 0.98rem;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.25s, color 0.25s, box-shadow 0.25s, transform 0.15s;
    box-shadow: 0 0 8px rgba(57, 255, 20, 0.2);
}

button:hover,
button:focus {
    background-color: var(--cor-verde);
    color: #001400;
    outline: none;
    box-shadow: 0 0 16px var(--cor-verde);
    transform: translateY(-1px);
}

.caixa-resultado {
    margin-top: 8px;
}

.texto-resultado {
    color: var(--cor-texto);
    line-height: 1.7;
    text-align: left;
    white-space: pre-wrap;
}

.botao-reiniciar {
    margin-top: 20px;
    text-align: center;
    display: none;
}

@media (max-width: 520px) {
    .caixa-principal {
        padding: 20px 16px 24px;
    }

    button {
        font-size: 0.92rem;
    }
}
