let atual = 0;
let historiaFinal = "";

function mostraPergunta() {
    if (atual >= perguntas.length) {
        mostraResultado();
        return;
    }

    const perguntaAtual = perguntas[atual];
    progresso.textContent = `pergunta ${atual + 1} de ${perguntas.length}`;
    caixaPerguntas.textContent = perguntaAtual.enunciado;
    caixaAlternativas.innerHTML = "";
    textoResultado.textContent = "";
    botaoReiniciar.style.display = "none";

    perguntaAtual.alternativas.forEach((alternativa) => {
        const botao = document.createElement("button");
        botao.textContent = alternativa.texto;
        botao.addEventListener("click", () => respostaSelecionada(alternativa));
        caixaAlternativas.appendChild(botao);
    });
}

function respostaSelecionada(opcaoSelecionada) {
    historiaFinal += opcaoSelecionada.afirmacao + " ";
    atual += 1;
    mostraPergunta();
}

function mostraResultado() {
    progresso.textContent = "transmissão concluída";
    caixaPerguntas.textContent = "Em 2049, o futuro que você ajudou a escrever ficou assim:";
    textoResultado.textContent = historiaFinal.trim();
    caixaAlternativas.innerHTML = "";
    botaoReiniciar.style.display = "inline-block";
}

function reiniciarQuestionario() {
    atual = 0;
    historiaFinal = "";
    mostraPergunta();
}

botaoReiniciar.addEventListener("click", reiniciarQuestionario);
mostraPergunta();
